{

"compilerOptions": {
    "module": "esnext",
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "outDir": "js",
    "moduleResolution": "bundler",
    "lib": ["dom", "es2015"],
    "target": "esnext"
  },

    "include": ["./ts/**/*.ts"],
		"ignore": ["./node_modules/**/*"]
}
